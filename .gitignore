# Environment variables
.env
.env.local
.env.*.local
.agentcore.env

# Team-specific env files (e.g. .env.team02, .agentcore.env.team02) - real
# secrets, never commit. The *.example files are committed templates, not
# real secrets - explicitly re-included below.
.env.team*
.agentcore.env.team*
!.env.team01.example
!.agentcore.env.team01.example
!.env.team02.example
!.agentcore.env.team02.example

# Local backups of env files (contain real secrets, never commit)
env_backups/

# Markdown docs - ignore all except the core onboarding/setup docs
*.md
!README.md
!HACKATHON_README.md
!AWS_AGENTCORE_TEAM_ONBOARDING_STEPS.md
!ARCHITECTURE.md

# Virtual environment
venv/
ENV/
env/
.venv

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# AWS credentials (if accidentally saved)
~/.aws/credentials
~/.aws/config

# Temporary files
*.tmp
*.bak
.temp/

# Data files (optional - uncomment if needed)
# data/*.csv
# data/*.json
