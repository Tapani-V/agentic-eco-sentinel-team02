# Environment variables
.env
.env.local
.env.*.local
.agentcore.env

# Team-specific env files (e.g. .env.team01, .agentcore.env.team01) - real
# secrets, never commit. Does not match .env.example/.agentcore.env.example.
.env.team*
.agentcore.env.team*

# Local backups of env files (contain real secrets, never commit)
env_backups/

# Virtual environment
venv/
ENV/
env/
.venv

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# AWS credentials (if accidentally saved)
~/.aws/credentials
~/.aws/config

# Temporary files
*.tmp
*.bak
.temp/

# Data files (optional - uncomment if needed)
# data/*.csv
# data/*.json
