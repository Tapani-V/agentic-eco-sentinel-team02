# AgentCore Gateway environment - team01 example (Frankfurt / eu-central-1).
# Mirrors team01's real, working config structure for the fully-isolated
# per-team model (own Cognito pool, own Gateway, own Runtimes - see
# TEAM_ONBOARDING_STEPS.md). Copy to .agentcore.env.<team_id> for a new team
# and replace the "team01" values below with your own team ID; COGNITO_* /
# GATEWAY_* / Lambda ARNs / CREATE_WORK_ORDER_URL are unique per team and get
# filled in automatically as you run the onboarding steps.
#
# COGNITO_APP_CLIENT_SECRET is a real credential - never commit an actual
# value here, it's scrubbed to a placeholder below.

# AWS Account Information
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=450410489798
AWS_PROFILE=StandardAccess-450410489798
PERMISSION_BOUNDARY=GroupIT_ProjectPermissionBoundary

# Hackathon team namespace - required by scripts/deploy_to_agentcore_boto3.py and
# deployment/agentcore-runtime/build_and_push.sh. Fully-isolated model: this also
# drives a separate Cognito pool + Gateway for this team (via this env file), not
# just the AgentCore Runtime names/ECR tag.
TEAM_ID=team01

# On a corporate network that intercepts TLS (SSL: CERTIFICATE_VERIFY_FAILED errors
# from boto3/httpx), uncomment this so AWS calls trust the proxy's CA chain too:
# AWS_CA_BUNDLE=config/minimal_certificate_bundle.pem

# Cognito Configuration - COGNITO_USER_POOL_ID is auto-populated by cognito_setup.py
# (onboarding step 1), COGNITO_APP_CLIENT_ID/SECRET/COGNITO_TOKEN_ENDPOINT by
# setup_cognito_token_flow.py (onboarding step 2). Leave the two IDs below blank
# until those scripts fill them in - they're unique per team, not guessable/reusable.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_USER_POOL_NAME=team01-user-pool
COGNITO_CLIENT_NAME=team01-confidential-client
COGNITO_DOMAIN_PREFIX=team01-auth

# Data-plane token flow
COGNITO_APP_CLIENT_SECRET=<fill-in-from-setup_cognito_token_flow.py-output>
COGNITO_TOKEN_ENDPOINT=https://team01-auth.auth.eu-central-1.amazoncognito.com/oauth2/token
COGNITO_SCOPE=agentcore/invoke

# AgentCore Gateway (from gateway_info.<team_id>.json), created by onboarding
# step 3 (create_agentcore_gateway_starter.py) - leave GATEWAY_URL/AGENTCORE_GATEWAY_ID
# blank until that script fills them in (unique per team).
GATEWAY_URL=
AGENTCORE_GATEWAY_ID=
# AgentCoreGatewayExecutionRole is a shared, account-wide IAM role reused by every team.
AGENTCORE_GATEWAY_ROLE_ARN=arn:aws:iam::450410489798:role/AgentCoreGatewayExecutionRole

# S3 for synthetic device data - shared/read-only across all teams, do not change
SYNTHETIC_DATA_BUCKET=agentic-ai-poc-synthetic-data
SYNTHETIC_DATA_PREFIX=devices/

# SSL/TLS Certificate Bundle for Corporate Proxies
# If running in a corporate environment with a proxy, set this to the CA bundle path.
AWS_CA_BUNDLE=config/minimal_certificate_bundle.pem

# MCP Tool Lambda ARNs - this team's own get-spare-parts/schedule-maintenance
# Lambdas, created by onboarding steps 3c/3d (setup_dynamodb_for_mcp_tools.py,
# deploy_mcp_lambdas.py)
GET_SPARE_PARTS_LAMBDA_ARN=arn:aws:lambda:eu-central-1:450410489798:function:team01-get-spare-parts
SCHEDULE_MAINTENANCE_LAMBDA_ARN=arn:aws:lambda:eu-central-1:450410489798:function:team01-schedule-maintenance

# create_work_order is an App Runner service, not a Lambda -
# scripts/register_mcp_tools_starter.py reads this URL var, not an ARN.
# Created by onboarding step 7 (App Runner deploy) - leave blank until then.
CREATE_WORK_ORDER_URL=

# Logging
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
