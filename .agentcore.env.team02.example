# Team02 Frankfurt environment template.
# Copy to .agentcore.env.team02 before starting onboarding. Do not commit the real file.

AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=450410489798
AWS_PROFILE=StandardAccess-450410489798
PERMISSION_BOUNDARY=GroupIT_ProjectPermissionBoundary
TEAM_ID=team02

# Filled automatically by onboarding steps 1 and 2.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
COGNITO_TOKEN_ENDPOINT=
COGNITO_SCOPE=agentcore/invoke
COGNITO_USER_POOL_NAME=team02-user-pool
COGNITO_CLIENT_NAME=team02-confidential-client
COGNITO_DOMAIN_PREFIX=team02-auth

# Filled automatically by onboarding step 3.
GATEWAY_URL=
AGENTCORE_GATEWAY_ID=
AGENTCORE_GATEWAY_ROLE_ARN=arn:aws:iam::450410489798:role/AgentCoreGatewayExecutionRole

# Synthetic device data is intentionally shared across teams.
SYNTHETIC_DATA_BUCKET=agentic-ai-poc-synthetic-data
SYNTHETIC_DATA_PREFIX=devices/
AWS_CA_BUNDLE=config/minimal_certificate_bundle.pem

# Filled automatically by onboarding step 6.
GET_SPARE_PARTS_LAMBDA_ARN=
SCHEDULE_MAINTENANCE_LAMBDA_ARN=

# Filled automatically by onboarding step 7.
CREATE_WORK_ORDER_URL=

LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
