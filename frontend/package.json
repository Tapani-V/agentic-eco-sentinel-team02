{
  "name": "agentic-eco-sentinel-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:cloudfront": "tsc --noEmit && vite build --mode cloudfront",
    "test": "vitest --run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@tanstack/react-query": "5.59.0",
    "chart.js": "4.4.0",
    "react-chartjs-2": "5.2.0"
  },
  "devDependencies": {
    "vite": "5.4.11",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "jsdom": "25.0.1",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@testing-library/jest-dom": "6.6.3",
    "fast-check": "3.23.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "9.15.0",
    "@eslint/js": "9.15.0",
    "typescript-eslint": "8.15.0",
    "stylelint": "16.10.0",
    "stylelint-config-standard": "36.0.1"
  }
}
