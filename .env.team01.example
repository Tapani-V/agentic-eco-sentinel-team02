# Example env file for a new team's Cognito/IAM bootstrap (scripts/cognito_setup.py,
# scripts/iam_setup.py, via scripts/main_setup.py). Mirrors team01's real, working
# Frankfurt (eu-central-1) config. Copy to .env.<team_id> (e.g. .env.team02) and
# replace the "team01" values below with your own team ID.

# AWS Configuration
AWS_REGION=eu-central-1
AWS_PROFILE=StandardAccess-450410489798

# Account Configuration
AWS_ACCOUNT_ID=450410489798

# Permission Boundary
PERMISSION_BOUNDARY=GroupIT_ProjectPermissionBoundary

# Cognito Configuration
COGNITO_USER_POOL_NAME=team01-user-pool
COGNITO_CLIENT_NAME=team01-client
COGNITO_TEST_USER_EMAIL=test@example.com
COGNITO_TEST_USER_PASSWORD=

# Project Configuration
PROJECT_NAME=agentic-ai-poc-3_1
ENVIRONMENT=development
