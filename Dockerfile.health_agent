FROM python:3.11-slim

WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ ./src/
COPY config/ ./config/

# Copy the AgentCore entry point script
COPY agentcore_entrypoint.py .

# AgentCore Runtime requires the container to serve HTTP on port 8080
# (POST /invocations, GET /ping) - see bedrock_agentcore.runtime.BedrockAgentCoreApp
EXPOSE 8080

# Health check against the AgentCore Runtime /ping endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8080/ping || exit 1

# AgentCore Runtime entry point
# Invokes the handler module that AgentCore Runtime sends payloads to
CMD ["python", "agentcore_entrypoint.py", "src.services.health_agent.handler", "--port", "8080"]
