# =====================================================
# Agentic AI POC - Environment Configuration Template
# =====================================================
# Copy this file to .agentcore.env and fill in your AWS credentials
# This file should NOT be committed to version control
# =====================================================

# ============================================
# AWS Configuration
# ============================================
# AWS Region for all services
AWS_REGION=us-east-1

# AWS Credentials (from IAM user with appropriate permissions)
# Permissions Required:
#   - S3: GetObject on spare-parts bucket
#   - DynamoDB: PutItem/GetItem on maintenance-schedule table
#   - Lambda: InvokeFunction for scheduled-maintenance-executor
#   - CloudWatch: PutMetricData for monitoring
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE

# ============================================
# Cognito Configuration
# ============================================
# AWS Cognito domain for token authentication
# Format: https://your-domain.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=https://agentic-ai.auth.us-east-1.amazoncognito.com

# OAuth 2.0 Client ID (Machine-to-Machine credentials)
# Create an "App client" in Cognito User Pool with client_credentials grant
COGNITO_CLIENT_ID=YOUR_COGNITO_CLIENT_ID

# OAuth 2.0 Client Secret (for client_credentials flow)
COGNITO_CLIENT_SECRET=YOUR_COGNITO_CLIENT_SECRET

# ============================================
# MCP Gateway Configuration
# ============================================
# AgentCore MCP Gateway URL (where MCP tools are exposed)
# Local development: http://localhost:9000
# Production: Your deployed MCP Gateway endpoint
MCP_GATEWAY_URL=http://localhost:9000

# ============================================
# LLM Configuration
# ============================================
# OpenAI API key for DiagnosisAgent reasoning
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4

# ============================================
# Application Configuration
# ============================================
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Service names (optional, for logging/tracing)
SERVICE_NAME=agentic-ai

# ============================================
# AWS Service Endpoints
# ============================================
# S3 Bucket for spare parts inventory
# Format: s3://bucket-name/spare-parts/
AWS_SPARE_PARTS_BUCKET=agentic-ai-spare-parts
AWS_SPARE_PARTS_PREFIX=spare-parts/

# DynamoDB Table for maintenance scheduling
# Schema: device_id (PK), scheduled_date (SK), maintenance_type, status
AWS_MAINTENANCE_TABLE=agentic-maintenance-schedule

# Lambda Function for scheduled maintenance execution
# Triggered by EventBridge for scheduled maintenance jobs
AWS_MAINTENANCE_LAMBDA=agentic-scheduled-maintenance-executor

# ============================================
# Monitoring & Observability
# ============================================
# CloudWatch Log Group for centralized logging
# Format: /aws/agentic-ai/{SERVICE_NAME}
CLOUDWATCH_LOG_GROUP=/aws/agentic-ai

# X-Ray Tracing (optional, for request tracing across services)
XRAY_TRACING_ENABLED=false

# ============================================
# Security Configuration
# ============================================
# JWT Token Cache TTL (seconds) - how long to cache Cognito tokens
TOKEN_CACHE_TTL=3600

# API Request Timeout (seconds)
REQUEST_TIMEOUT=30

# ============================================
# Development / Local Testing
# ============================================
# Set to 'true' for local testing with mock responses
# MOCK_MCP_TOOLS=false

# Docker Compose Network
# Used internally by services to communicate
# DO NOT CHANGE unless modifying docker-compose.yml
DOCKER_NETWORK=agentic-network
