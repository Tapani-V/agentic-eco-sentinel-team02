
# AgentCore Gateway Automation Environment Example
# Fill in your actual values and rename to .agentcore.env

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=StandardAccess-450410489798
AWS_ACCOUNT_ID=450410489798
PERMISSION_BOUNDARY=GroupIT_ProjectPermissionBoundary

# Cognito
COGNITO_USER_POOL_ID=us-east-1_R6pOfxcKV
COGNITO_APP_CLIENT_ID=2a8at414274aard1bvn12gt3h2
COGNITO_USER_POOL_NAME=agentic-ai-poc-3-1-user-pool
COGNITO_CLIENT_NAME=agentic-ai-poc-3-1-client
COGNITO_DOMAIN_PREFIX=agentic-ai-poc-3-1-auth

# Data-plane token flow (filled by scripts/setup_cognito_token_flow.py)
COGNITO_APP_CLIENT_SECRET=
COGNITO_TOKEN_ENDPOINT=https://<your-cognito-domain>.auth.us-east-1.amazoncognito.com/oauth2/token
COGNITO_SCOPE=agentcore/invoke

# MCP Tool ARNs/URLs
GET_SPARE_PARTS_LAMBDA_ARN=arn:aws:lambda:us-east-1:YOUR_ACCOUNT_ID:function:get_spare_parts
SCHEDULE_MAINTENANCE_LAMBDA_ARN=arn:aws:lambda:us-east-1:YOUR_ACCOUNT_ID:function:schedule_maintenance
CREATE_WORK_ORDER_URL=https://your-app-runner-url/work_order

# (Add more tool ARNs/URLs as needed)
